{
  "manifest_version": 3,
  "name": "Split Search",
  "version": "0.1.0",
  "description": "地址栏或拖拽搜索，一键用两个搜索引擎打开原生分屏对比",
  "minimum_chrome_version": "155",
  "incognito": "not_allowed",
  "key": "",
  "permissions": [
    "declarativeNetRequest",
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "go.html"
      ],
      "matches": [
        "<all_urls>"
      ],
      "use_dynamic_url": true
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Split Search 设置"
  }
}
